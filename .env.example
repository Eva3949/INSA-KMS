# KMS Enterprise Environment Configuration Template
# Path: C:\Users\PC\Downloads\KMS\.env.example

# Domain & Protocols
DOMAIN=kms.enterprise.internal
FRONTEND_URL=https://kms.enterprise.internal
BACKEND_URL=https://kms.enterprise.internal/api/v1

# PostgreSQL Database
DATABASE_HOST=kms-postgres
DATABASE_PORT=5432
DATABASE_NAME=kmsdb
DATABASE_USERNAME=kmsuser
DATABASE_PASSWORD=kmspassword

# Keycloak OIDC Authentication
KEYCLOAK_URL=https://kms.enterprise.internal/realms/kms-realm
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
OIDC_CLIENT_ID=kms-frontend-client
OIDC_CLIENT_SECRET=kms-frontend-secret-placeholder

# Microsoft Graph / Office 365 Integration (FR-24)
MS_GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_GRAPH_CLIENT_SECRET=ms-graph-secret-placeholder
MS_GRAPH_TENANT_ID=common
