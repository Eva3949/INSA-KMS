FROM quay.io/keycloak/keycloak:24.0.1

# Copy pre-configured realm import file
COPY keycloak/kms-realm.json /opt/keycloak/data/import/kms-realm.json

# Environment configuration disabling strict hostname resolution in all modes
ENV KC_DB=postgres
ENV KC_HOSTNAME_STRICT=false
ENV KC_HOSTNAME_STRICT_BACKCHANNEL=false
ENV KC_HOSTNAME_STRICT_HTTPS=false
ENV KC_HTTP_ENABLED=true
ENV KC_PROXY_HEADERS=xforwarded

# Entrypoint supporting both start-dev and start execution on cloud hosts
ENTRYPOINT ["/opt/keycloak/bin/kc.sh", "start-dev", "--import-realm", "--hostname-strict=false", "--hostname-strict-backchannel=false", "--hostname-strict-https=false", "--http-enabled=true", "--proxy-headers=xforwarded"]
