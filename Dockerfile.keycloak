FROM quay.io/keycloak/keycloak:24.0.1

# Copy pre-configured realm import file for automatic initialization
COPY keycloak/kms-realm.json /opt/keycloak/data/import/kms-realm.json

# Disable strict hostname resolution and enable HTTP/proxy headers for Render
ENV KC_DB=postgres
ENV KC_HOSTNAME_STRICT=false
ENV KC_HOSTNAME_STRICT_BACKCHANNEL=false
ENV KC_HTTP_ENABLED=true
ENV KC_PROXY_HEADERS=xforwarded

# Entrypoint using start-dev --import-realm to listen on 0.0.0.0:8080 and bypass hostname strictness
ENTRYPOINT ["/opt/keycloak/bin/kc.sh", "start-dev", "--import-realm"]
