FROM quay.io/keycloak/keycloak:24.0.1

# Copy pre-configured realm import file
COPY keycloak/kms-realm.json /opt/keycloak/data/import/kms-realm.json

# Environment variables for runtime execution on Render
ENV KC_DB=postgres
ENV KC_HEALTH_ENABLED=true
ENV KC_METRICS_ENABLED=true
ENV KC_HOSTNAME_STRICT=false
ENV KC_HOSTNAME_STRICT_BACKCHANNEL=false
ENV KC_HOSTNAME_STRICT_HTTPS=false
ENV KC_HTTP_ENABLED=true
ENV KC_PROXY_HEADERS=xforwarded
ENV KC_HTTP_PORT=8080

# Build Keycloak image for PostgreSQL (using valid build-time flags only)
RUN /opt/keycloak/bin/kc.sh build --db=postgres

# Runtime entrypoint
ENTRYPOINT ["/opt/keycloak/bin/kc.sh", "start-dev", "--import-realm"]
