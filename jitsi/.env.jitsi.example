# =============================================================================
# INSA KMS — Self-Hosted Jitsi Meet & Prosody JWT Environment Template
# DO NOT COMMIT REAL PRODUCTION SECRETS TO SOURCE CONTROL
# =============================================================================

# Public domain/hostname for Jitsi Web ingress (accessible by authorized KMS users)
KMS_JITSI_DOMAIN=jitsi.kms.internal
KMS_JITSI_PUBLIC_URL=https://jitsi.kms.internal:8443
JITSI_HTTPS_PORT=8443
JITSI_HTTP_PORT=8088

# Jitsi JWT Authentication Parameters (MUST match Spring Boot KMS_JITSI_JWT_SECRET)
KMS_JITSI_JWT_APP_ID=insa-kms-video
# Generate via: openssl rand -base64 32
KMS_JITSI_JWT_SECRET=REPLACE_WITH_SECURE_MIN_32_CHAR_PRODUCTION_SECRET

# WebRTC UDP Media Port (Single-port configuration)
JVB_PORT=10000
# Internal IP / Host interface for JVB media routing
JVB_ADVERTISED_IP=127.0.0.1

# Internal XMPP Component Secrets (Prosody <-> Jicofo / JVB internal communication)
JICOFO_AUTH_PASSWORD=REPLACE_WITH_SECURE_JICOFO_COMPONENT_PASSWORD
JVB_AUTH_PASSWORD=REPLACE_WITH_SECURE_JVB_COMPONENT_PASSWORD
