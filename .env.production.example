# KMS Enterprise Production Environment Template
# Path: C:\Users\PC\Downloads\KMS\.env.production.example

# Domain & Endpoints
DOMAIN=kms.example.org
FRONTEND_URL=https://kms.example.org
API_URL=https://api.example.org/api/v1
KEYCLOAK_URL=https://auth.example.org/realms/kms-realm

# PostgreSQL Production Database
DATABASE_HOST=kms-postgres-prod
DATABASE_PORT=5432
DATABASE_NAME=kmsdb_prod
DATABASE_USERNAME=kms_prod_user
DATABASE_PASSWORD=kms_secure_production_password_change_me

# Keycloak Authentication & Secrets
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=kms_keycloak_admin_password_change_me
OIDC_CLIENT_ID=kms-frontend-client
OIDC_CLIENT_SECRET=kms_oidc_client_secret_change_me

# Microsoft Graph / Office 365 Enterprise Credentials (FR-24)
MS_GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_GRAPH_CLIENT_SECRET=ms_graph_app_secret_change_me
MS_GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
